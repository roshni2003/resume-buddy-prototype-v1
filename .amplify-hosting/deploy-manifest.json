{
  "version": 1,
  "routes": [
    {
      "path": "/assets/*",
      "target": {
        "kind": "Static"
      },
      "fallback": null
    },
    {
      "path": "/*",
      "target": {
        "kind": "Compute",
        "src": "default"
      },
      "fallback": null
    }
  ],
  "computeResources": [
    {
      "name": "default",
      "runtime": "nodejs20.x",
      "entrypoint": "server.js"
    }
  ]
}
