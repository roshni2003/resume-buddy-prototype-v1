{
	"buildCommand": "pnpm build && cp -r migrations .output/server/ || true",
	"outputDirectory": ".output/public",
	"framework": null,
	"installCommand": "pnpm install",
	"devCommand": "pnpm dev",
	"functions": {
		"api/**/*.js": {
			"memory": 2048,
			"maxDuration": 30
		}
	},
	"rewrites": [
		{
			"source": "/(.*)",
			"destination": "/api/index"
		}
	]
}